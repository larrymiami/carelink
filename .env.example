DATABASE_URL=postgres://carelink:carelink@localhost:5432/carelink
APP_MODE=sample
PORT=3001
# Generate independently for each deployment; never expose these in browser bundles.
SAMPLE_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
OPERATOR_API_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
EVENT_HMAC_KEY=replace-with-another-random-secret-at-least-32-characters
RETENTION_DAYS=7
API_BASE_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
DEMO_LOGIN_PASSWORD=replace-with-a-local-workspace-password-at-least-16-characters
# Set true for HTTPS deployments. Local HTTP development uses false.
COOKIE_SECURE=false
