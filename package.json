{
  "name": "carelink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community health service navigation and human follow-up over WhatsApp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx --env-file=.env apps/api/src/server.ts",
    "worker:dev": "node --import tsx --env-file=.env apps/api/src/worker-main.ts",
    "db:migrate": "node --import tsx --env-file=.env scripts/migrate.ts",
    "db:purge-expired": "node --import tsx --env-file=.env scripts/purge.ts",
    "typecheck": "tsc --noEmit && next typegen apps/web && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:report": "node --import tsx scripts/test-report.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "db:local": "node --env-file=.env --import tsx scripts/local-db.ts",
    "web:dev": "node --env-file=.env node_modules/next/dist/bin/next dev apps/web --hostname 127.0.0.1 --port 3000",
    "web:build": "next build apps/web",
    "test:browser": "playwright test",
    "test:browser:report": "node --import tsx scripts/browser-report.ts",
    "verify:report": "npm run typecheck && npm run web:build && npm run test:report && npm run test:browser:report"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.6.0",
    "@mui/material": "9.6.0",
    "@mui/material-nextjs": "9.6.0",
    "fastify": "5.12.8",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.12.0-beta.19",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
